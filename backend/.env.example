NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb://127.0.0.1:27017/authentication_db
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-different-long-random-secret
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL=Authentication System <onboarding@resend.dev>
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
RECAPTCHA_SECRET_KEY=replace-with-your-recaptcha-secret-key
